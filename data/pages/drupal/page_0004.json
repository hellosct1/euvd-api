{"items":[{"id":"EUVD-2022-3195","enisaUuid":"ca6da101-25f4-34b4-a49b-ccbb3f0b9a92","description":"Cross-site scripting vulnerability in Drupal Core. Drupal AJAX API does not disable JSONP by default, allowing for an XSS attack. This issue affects: Drupal Drupal Core 7.x versions prior to 7.73; 8.8.x versions prior to 8.8.10; 8.9.x versions prior to 8.9.6; 9.0.x versions prior to 9.0.6.","datePublished":"May 5, 2021, 1:50:13 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2020-007\n","aliases":"CVE-2020-13666\nGHSA-8jj2-x2gc-ggm7\n","assigner":"drupal","epss":2.93,"enisaIdProduct":[{"id":"6b0edc25-a290-309d-9c64-974edad7de7e","product":{"name":"drupal core","vendor":{"name":"Drupal"}},"product_version":"8.8.x \u003c8.8.10"},{"id":"b64ee399-4670-34f4-8222-2ea31d8a0acf","product":{"name":"drupal core","vendor":{"name":"Drupal"}},"product_version":"9.0.x \u003c9.0.6"},{"id":"b8177e67-a4cb-31e0-a9ae-29a717e6a683","product":{"name":"drupal core","vendor":{"name":"Drupal"}},"product_version":"7.x \u003c7.73"},{"id":"e509b300-1209-35d6-a6fe-0318756c19d2","product":{"name":"drupal core","vendor":{"name":"Drupal"}},"product_version":"8.9.x \u003c8.9.6"}],"enisaIdVendor":[{"id":"980df69c-bd62-31a2-a884-10f504d1f54d","vendor":{"name":"Drupal"}}]},{"id":"EUVD-2022-1196","enisaUuid":"09e194b7-7b80-327e-84ec-d8b005c7ac68","description":"Drupal\u0027s JSON:API and REST/File modules allow file uploads through their HTTP APIs. The modules do not correctly run all file validation, which causes an access bypass vulnerability. An attacker might be able to upload files that bypass the file validation process implemented by modules on the site.","datePublished":"Feb 11, 2022, 3:45:11 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2021-008\n","aliases":"CVE-2020-13675\nGHSA-v8wr-r69p-mmwx\n","assigner":"drupal","epss":1.39,"enisaIdProduct":[{"id":"78308477-7731-3c41-ae7a-