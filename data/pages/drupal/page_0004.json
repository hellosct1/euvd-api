.0.6.","datePublished":"Feb 11, 2022, 3:45:22 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2020-011\n","aliases":"GHSA-mmjr-5q74-p3m4\nCVE-2020-13670\n","assigner":"drupal","epss":1.11,"enisaIdProduct":[{"id":"24129026-178e-32fb-b7b7-71c8d43d30f3","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.8.x \u003c8.8.10"},{"id":"cd01312e-4711-3134-b395-372293277480","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"9.0.x \u003c9.0.6"},{"id":"d75a18c9-e005-3842-a740-69616aeef2cf","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.9.x \u003c8.9.6"}],"enisaIdVendor":[{"id":"af422e1b-c133-3c6d-bf00-3b4139da300e","vendor":{"name":"Drupal"}}]},{"id":"EUVD-2022-1096","enisaUuid":"bcba718f-8ca9-3565-aa0c-a4634cc00d0c","description":"Access Bypass vulnerability in Drupal Core allows for an attacker to leverage the way that HTML is rendered for affected forms in order to exploit the vulnerability. This issue affects: Drupal Core 8.8.x versions prior to 8.8.10; 8.9.x versions prior to 8.9.6; 9.0.x versions prior to 9.0.6.","datePublished":"Feb 11, 2022, 3:15:14 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2020-009\n","aliases":"CVE-2020-13668\nGHSA-m6q5-wv4x-fv6h\n","assigner":"drupal","epss":0.79,"enisaIdProduct":[{"id":"1a05e37b-d798-3fdc-bdb0-905b41fa925f","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.8.x \u003c8.8.10"},{"id":"2c51d8df-d142-3a62-ab71-0c80912b62b1","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.9.x \u003c8.9.6"},{"id":"c9def6c3-9956-3be9-8a44-50d1f3b334f0","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"9.0.x \u003c9.0.6"}],"enisaIdVendor":[{"id":"4943fcae-6a66-3763-a3c1-d5b78d530c13","vendor":{"name":"Drupal"}}]},{"id":"EUVD-2022-1066","enisaUuid":"7250405a-277c-3eb5-ad64-b2d347e8ef84","description":"The QuickEdit module does not properly validate access to routes, which could allow cross-site request forgery under some circumstances and lead to possible data integrity issues. Sites are only affected if the QuickEdit module (which comes with the Standard profile) is installed. Removing the \"access in-place editing\" permission from untrusted users will not fully mitigate the vulnerability.","datePublished":"Feb 11, 2022, 3:45:18 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2021-007\n","aliases":"GHSA-j586-cj67-vg4p\nCVE-2020-13674\n","assigner":"drupal","epss":0.46,"enisaIdProduct":[{"id":"2e07e13d-3a36-3ea2-b2e6-17bf82b8e6e4","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"9.1 \u003c9.1.13"},{"id":"37ccf216-5dc2-3e06-bef7-e90b7e67f1b8","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.9 \u003c8.9.19"},{"id":"4ee2aed5-0f2f-37f7-b180-91f424626267","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"9.2 \u003c9.2.6"}],"enisaIdVendor":[{"id":"22701e3a-4226-3e27-8606-09c6a4ca64ea","vendor":{"name":"Drupal"}}]},{"id":"EUVD-2022-0950","enisaUuid":"c054598e-0e06-34cb-b36f-09808559a2b7","description":"Cross-site Scripting (XSS) vulnerability in ckeditor of Drupal Core allows attacker to inject XSS. This issue affects: Drupal Core 8.8.x versions prior to 8.8.10.; 8.9.x versions prior to 8.9.6; 9.0.x versions prior to 9.0.6.","datePublished":"Feb 11, 2022, 3:25:12 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2020-010\n","aliases":"GHSA-c533-c843-67h8\nCVE-2020-13669\n","assigner":"drupal","epss":0.74,"enisaIdProduct":[{"id":"5be8d96d-0719-3184-8b96-94dd2d9cff9a","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.9.x \u003c8.9.6"},{"id":"636e0457-1598-3eab-ada5-0597d9a199ea","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"9.0.x \u003c9.0.6"},{"id":"78ed86c7-5c88-3112-bc0e-b3fb348e4a37","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.8.x \u003c8.8.10"}],"enisaIdVendor":[{"id":"cd902f9b-4550-359c-9a2a-bbc2c052e600","vendor":{"name":"Drupal"}}]},{"id":"EUVD-2022-0799","enisaUuid":"e9d3c9a1-dcfc-3702-b44b-8230b22457c3","description":"Under some circumstances, the Drupal core JSON:API module does not properly restrict access to certain content, which may result in unintended access bypass. Sites that do not have the JSON:API module enabled are not affected.","datePublished":"Feb 11, 2022, 3:55:12 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2021-010\n","aliases":"CVE-2020-13677\nGHSA-3xr3-phjp-g6p2\n","assigner":"drupal","epss":1.22,"enisaIdProduct":[{"id":"2942bf18-a522-3ae7-83d9-2c91910eb0e1","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"8.9.x \u003c8.9.19"},{"id":"5e0314a0-2ef9-3758-9496-6fa5be4ff15c","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"9.2.x \u003c9.2.6"},{"id":"fbfd68bd-9d28-3ac6-a692-cbc961278a4a","product":{"name":"core","vendor":{"name":"OPNsense"}},"product_version":"9.1.x \u003c9.1.13"}],"enisaIdVendor":[{"id":"44e87b98-181b-3daa-9430-1ba883a48eb8","vendor":{"name":"Drupal"}}]},{"id":"EUVD-2022-0793","enisaUuid":"3ea65862-753f-37c2-bfb6-25455377f4fe","description":"Cross-site Scripting (XSS) vulnerability in Drupal core\u0027s sanitization API fails to properly filter cross-site scripting under certain circumstances. This issue affects: Drupal Core 9.1.x versions prior to 9.1.7; 9.0.x versions prior to 9.0.12; 8.9.x versions prior to 8.9.14; 7.x versions prior to 7.80.","datePublished":"Feb 11, 2022, 3:30:12 PM","dateUpdated":"Aug 4, 2024, 12:25:16 PM","baseScore":null,"references":"https://www.drupal.org/sa-core-2021-002\n","aliases":"CVE-2020-13672\nGHSA-3m36-mjwj-352c\n","assigner":"drupal","epss":0.68,"enisaIdP